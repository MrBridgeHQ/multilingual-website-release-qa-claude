  "countries": [],
  "devices": [
    {
      "id": "desktop",
      "label": "Desktop Chromium 1366x768",
      "browser": "chromium",
      "viewport": {
        "width": 1366,
        "height": 768
      },
      "is_mobile": false
    },
    {
      "id": "mobile",
      "label": "Mobile emulation 390x844 (Chromium, touch)",
      "browser": "chromium",
      "viewport": {
        "width": 390,
        "height": 844
      },
      "is_mobile": true,
      "has_touch": true
    }
  ],
  "auth": {
    "method": "none"
  },
  "allowed_actions": {
    "form_submission": "local-demo-only",
    "submit_paths": [
      "/api/contact"
    ],
    "notes": "The demo contact endpoint keeps nothing and sends nothing. No other POST is allowed."
  },
  "limits": {
    "timeout_ms": 8000,
    "retries": 0,
    "max_cases": 40,
    "max_minutes": 15
  },
  "output": {
    "dir": "qa-output",
    "formats": [
      "md",
      "json",
      "csv"
    ],
    "output_language": "en"
  },
  "assumptions": [
    "Expected localized strings and URL correspondences come from this config; they stand in for the product specification.",
    "Brand and product names listed in keep_untranslated are intentionally identical in both languages."
  ],
  "journeys": [
    {
      "id": "J12",
      "title": "Legacy URL behaviour",
      "priority": "P2",
      "device": "desktop",
      "languages": [
        "en"
      ],
      "steps": [
        {
          "action": "goto",
